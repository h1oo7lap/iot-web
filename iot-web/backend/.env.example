# ===== SERVER =====
PORT=3000

# ===== MQTT (Broker Connection) =====
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USER=your_username
MQTT_PASS=your_password

# ===== MOSQUITTO (Path to config file) =====
# Cần trỏ đúng đường dẫn đến file .conf trên máy của bạn
MOSQUITTO_CONF=C:/path/to/your/mosquitto/myconfig.conf

# ===== MYSQL (Database Connection) =====
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASS=your_db_password
DB_NAME=iot_db_v2